<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Richman.Server</RootNamespace>
    <AssemblyName>Richman.Server</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Socket.IO v3+ 兼容服务端 (支持 Engine.IO v4) -->
    <PackageReference Include="SocketIO.Core" Version="3.1.2" />
    <PackageReference Include="SocketIO.Serializer.SystemTextJson" Version="3.1.2" />
    <PackageReference Include="Microsoft.AspNetCore.WebSockets" Version="2.3.11" />
  </ItemGroup>

</Project>