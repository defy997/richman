<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Richman.Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="Richman.Client.Views.FuturesView"
             x:DataType="vm:FuturesViewModel">

    <Design.DataContext>
        <vm:FuturesViewModel />
    </Design.DataContext>

    <Border Background="#0f172a" Padding="12">
        <Grid ColumnDefinitions="320,*" RowDefinitions="*,Auto">

            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Text="🛢️ 期货市场" FontWeight="Bold"
                           Foreground="#fbbf24" FontSize="16" Margin="0,0,0,8"/>
                <ListBox ItemsSource="{Binding Futures}"
                         SelectedItem="{Binding SelectedSymbol, Mode=TwoWay}"
                         Background="#1f2937">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" Margin="4">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Foreground="#9ca3af" FontSize="10">
                                        <Run Text="{Binding Symbol}" />
                                        <Run Text=" · 到期 " />
                                        <Run Text="{Binding ExpiresOnDay}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Price, StringFormat=${0:N2}}"
                                               Foreground="#fde68a" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Foreground="#10b981" FontSize="10"
                                               IsVisible="{Binding Change, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <Run Text="▲" />
                                        <Run Text="{Binding Change, StringFormat={}{0:P2}}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
                <Border Grid.Row="0" Background="#1f2937" Padding="12" CornerRadius="6" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Foreground="White" FontSize="20" FontWeight="Bold">
                            <Run Text="{Binding Selected.Name, FallbackValue='-'}" />
                            <Run Text=" "/>
                            <Run Text="{Binding Selected.Symbol}" Foreground="#9ca3af" FontSize="14"/>
                        </TextBlock>
                        <TextBlock Foreground="#fde68a" FontSize="28" FontWeight="Bold">
                            <Run Text="{Binding Selected.Price, StringFormat=${0:N2}}" />
                        </TextBlock>
                        <TextBlock Foreground="#9ca3af" FontSize="12">
                            <Run Text="类别: " />
                            <Run Text="{Binding Selected.Category}" Foreground="#cbd5e1"/>
                            <Run Text="  · 到期日: " />
                            <Run Text="{Binding Selected.ExpiresOnDay}" Foreground="#cbd5e1"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="#1f2937" Padding="12" CornerRadius="6">
                    <TextBlock Foreground="#9ca3af" TextWrapping="Wrap"
                               Text="期货为高杠杆衍生品,看涨做多 (buy),看跌做空 (sell),平仓 (close) 结算盈亏。&#10;初始保证金仅 20%,最大杠杆 10x,价格波动 1% 可盈亏 10%。"/>
                </Border>

                <Border Grid.Row="2" Background="#1f2937" Padding="10" CornerRadius="6" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="数量" Foreground="#9ca3af" FontSize="10"/>
                            <NumericUpDown Minimum="1" Maximum="9999" Value="{Binding TradeQuantity}" Width="100"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="杠杆 (1-10)" Foreground="#9ca3af" FontSize="10"/>
                            <NumericUpDown Minimum="1" Maximum="10" Value="{Binding TradeLeverage}" Width="100"/>
                        </StackPanel>
                        <Button Grid.Row="1" Grid.Column="0" Content="🟢 做多"
                                Command="{Binding OpenLongCommand}" Background="#16a34a" Margin="0,0,4,0"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="🔴 做空"
                                Command="{Binding OpenShortCommand}" Background="#dc2626" Margin="0,0,4,0"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="❌ 平仓"
                                Command="{Binding CloseCommand}" Background="#0891b2"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
