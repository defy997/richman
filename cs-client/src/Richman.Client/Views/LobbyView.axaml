<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Richman.Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="Richman.Client.Views.LobbyView"
             x:DataType="vm:LobbyViewModel">

    <Design.DataContext>
        <vm:LobbyViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="*,360" Background="#0f172a">

        <!-- 左侧:创建/加入 -->
        <Grid Grid.Column="0" Margin="32" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*">

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                       Text="🏠 游戏大厅" Foreground="#fbbf24"
                       FontSize="32" FontWeight="Bold" Margin="0,0,0,20" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="玩家名:" VerticalAlignment="Center"
                       Foreground="White" Margin="0,0,12,8" />
            <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding PlayerName}" Margin="0,0,0,8" />

            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#1f2937" Padding="16" CornerRadius="8" Margin="0,12,0,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="多人模式" FontWeight="Bold" Foreground="#60a5fa" FontSize="16" />

                    <Grid ColumnDefinitions="Auto,*" >
                        <TextBlock Grid.Column="0" Text="最大玩家数 (2-6):" VerticalAlignment="Center"
                                   Foreground="White" Margin="0,0,12,0" />
                        <NumericUpDown Grid.Column="1" Minimum="2" Maximum="6" Value="{Binding MaxPlayers}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="创建房间" Command="{Binding CreateRoomCommand}" />
                        <TextBlock Text="(在浏览器访问 ws://host:port 的对手也可以加入你的房间)"
                                   Foreground="#9ca3af" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
                        <TextBlock Grid.Column="0" Text="房间号:" VerticalAlignment="Center"
                                   Foreground="White" Margin="0,0,12,0"/>
                        <TextBox   Grid.Column="1" Text="{Binding JoinRoomCode}" Watermark="ABCD" />
                        <Button    Grid.Column="2" Margin="8,0,0,0" Content="加入"
                                   Command="{Binding JoinRoomCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Grid.ColumnSpan="2" Background="#1f2937" Padding="16" CornerRadius="8" Margin="0,16,0,0">
                <StackPanel Spacing="8">
                    <TextBlock Text="单人模式 (AI 对战)" FontWeight="Bold" Foreground="#10b981" FontSize="16" />
                    <Grid ColumnDefinitions="Auto,*,Auto,*" >
                        <TextBlock Grid.Column="0" Text="AI 数量:" VerticalAlignment="Center"
                                   Foreground="White" Margin="0,0,12,0" />
                        <NumericUpDown Grid.Column="1" Minimum="1" Maximum="5" Value="{Binding AiCount}" />
                        <TextBlock Grid.Column="2" Text="难度:" VerticalAlignment="Center"
                                   Foreground="White" Margin="16,0,12,0" />
                        <ComboBox Grid.Column="3" SelectedItem="{Binding Difficulty}">
                            <x:String>easy</x:String>
                            <x:String>normal</x:String>
                            <x:String>hard</x:String>
                        </ComboBox>
                    </Grid>
                    <Button Content="开始单人游戏" HorizontalAlignment="Left"
                            Command="{Binding CreateSingleplayerCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 右侧:玩家列表 + 状态 -->
        <Border Grid.Column="1" Background="#1f2937" Margin="0,32,32,32" Padding="16" CornerRadius="8">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="玩家列表" FontWeight="Bold" Foreground="#fbbf24" FontSize="18" Margin="0,0,0,12" />

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                    <Button Content="开始游戏" Command="{Binding StartGameCommand}" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Store.Players}" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="4">
                                <Border Width="14" Height="14" CornerRadius="7"
                                        Background="{Binding Color}" />
                                <TextBlock Text="{Binding Name}" Foreground="White" />
                                <TextBlock Text="(AI)" Foreground="#9ca3af"
                                           IsVisible="{Binding IsAI}" />
                                <TextBlock Text="(你)" Foreground="#fbbf24"
                                           IsVisible="{Binding IsCurrentTurn}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
