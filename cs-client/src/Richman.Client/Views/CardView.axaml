<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Richman.Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="Richman.Client.Views.CardView"
             x:DataType="vm:CardViewModel">

    <Design.DataContext>
        <vm:CardViewModel />
    </Design.DataContext>

    <Border Background="#0f172a" Padding="12">
        <Grid RowDefinitions="Auto,*,Auto">

            <Border Grid.Row="0" Background="#1f2937" Padding="12" CornerRadius="6" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="🃏 我的卡片" FontWeight="Bold"
                               Foreground="#fbbf24" FontSize="16"/>
                    <TextBlock Foreground="#c4b5fd" FontSize="12" VerticalAlignment="Center">
                        <Run Text="💎 " />
                        <Run Text="{Binding MyPlayer.Diamonds}" FontWeight="Bold"/>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding MyPlayer.Cards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="x:String">
                                <Border Background="#7c3aed" Padding="6,2" CornerRadius="4">
                                    <TextBlock Foreground="White" FontSize="11" Text="{Binding}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding AvailableCards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:CardDef">
                            <Border Background="#1f2937" Padding="10" CornerRadius="6" Margin="0,4">
                                <Grid ColumnDefinitions="60,*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                               FontSize="28" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Foreground="White" FontSize="14" FontWeight="Bold">
                                            <Run Text="{Binding Name}"/>
                                            <Run Text=" · " Foreground="#9ca3af"/>
                                            <Run Text="{Binding Price, StringFormat={}{0} 💎}"
                                                 Foreground="#c4b5fd"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="#9ca3af" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Content="购买" Background="#16a34a"
                                                Click="OnBuyClick"
                                                Tag="{Binding Name}"
                                                Foreground="White"/>
                                        <Button Content="使用" Background="#7c3aed"
                                                Click="OnUseClick"
                                                Tag="{Binding Name}"
                                                Foreground="White"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 谣言卡操作区 -->
            <Border Grid.Row="2" Background="#1f2937" Padding="10" CornerRadius="6" Margin="0,8,0,0">
                <StackPanel Spacing="6">
                    <TextBlock Text="📢 谣言卡操作 (选好后按散布)" Foreground="#fbbf24" FontWeight="Bold"/>
                    <Grid ColumnDefinitions="*,120,140">
                        <ComboBox Grid.Column="0" ItemsSource="{Binding StockSymbols}"
                                  SelectedItem="{Binding RumorTarget}"
                                  PlaceholderText="选择股票"/>
                        <ComboBox Grid.Column="1" Margin="6,0"
                                  SelectedItem="{Binding RumorDirection}">
                            <ComboBoxItem Content="🟢 利好" Tag="good"/>
                            <ComboBoxItem Content="🔴 利空" Tag="bad"/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="📢 散布谣言"
                                Command="{Binding UseCardCommand}"
                                CommandParameter="谣言卡"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>