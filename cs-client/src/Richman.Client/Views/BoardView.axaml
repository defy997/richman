<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Richman.Client.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="1100"
             x:Class="Richman.Client.Views.BoardView"
             x:DataType="vm:BoardViewModel">

    <Design.DataContext>
        <vm:BoardViewModel />
    </Design.DataContext>

    <Border Background="#0b1220" Padding="8" CornerRadius="12">
        <Grid ColumnDefinitions="*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*"
              RowDefinitions="*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*">

            <!-- ============ 64 格 ============ -->
            <ItemsControl ItemsSource="{Binding Cells}" Grid.Row="0" Grid.RowSpan="17" Grid.Column="0" Grid.ColumnSpan="17">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid ColumnDefinitions="*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*"
                              RowDefinitions="*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:BoardCellViewModel">
                        <Button Click="OnCellClick"
                                Tag="{Binding Id}"
                                Padding="0" Margin="2"
                                Background="{Binding BackgroundColor}"
                                BorderBrush="{Binding OwnerBorderColor}"
                                BorderThickness="2"
                                CornerRadius="4"
                                Width="48" Height="48"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <Panel>
                                <Border IsVisible="{Binding Selected}"
                                        BorderBrush="#fbbf24" BorderThickness="3"
                                        CornerRadius="4"/>
                                <Grid RowDefinitions="Auto,*,Auto">
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0">
                                        <TextBlock Text="{Binding IconGlyph}" FontSize="10"/>
                                        <TextBlock Text="{Binding SpecialUpgradeBadge}"
                                                   IsVisible="{Binding IsSpecial}" FontSize="11"/>
                                        <TextBlock Text="{Binding LevelBadge}"
                                                   IsVisible="{Binding HasLevel}" FontSize="9"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="{Binding PureName}"
                                               Foreground="White" FontWeight="Bold"
                                               FontSize="9" TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center" Margin="1"/>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding BasePrice, StringFormat='${0:N0}'}"
                                                   Foreground="#fde68a" FontSize="7"
                                                   IsVisible="{Binding IsEmpty}"/>
                                        <TextBlock Text="{Binding Appreciation, StringFormat='+{0:P0}'}"
                                                   Foreground="#fde68a" FontSize="7"
                                                   IsVisible="{Binding Appreciation, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    </StackPanel>
                                </Grid>
                            </Panel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ============ 中央 RICH PARK ============ -->
            <Border Grid.Row="1" Grid.RowSpan="15" Grid.Column="1" Grid.ColumnSpan="15"
                    Background="#14532d" CornerRadius="8" Margin="6">
                <DockPanel LastChildFill="True" Margin="12">

                    <TextBlock DockPanel.Dock="Top" Text="RICH PARK" Foreground="#fde68a"
                               FontWeight="Black" FontSize="22" LetterSpacing="3"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>

                    <!-- 排行榜 -->
                    <Border DockPanel.Dock="Top" Background="#00000066" Padding="8"
                            CornerRadius="6" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="🏆 排行榜" Foreground="#fde68a"
                                       FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding PlayersSortedByAssets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,2">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                                <Ellipse Width="10" Height="10" Fill="{Binding Color}"
                                                         VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" Foreground="#e5e7eb"
                                                           FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Text="🤖" IsVisible="{Binding IsAI}" FontSize="10"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding TotalAssets, StringFormat='${0:N0}'}"
                                                       Foreground="#fde68a" FontWeight="Bold" FontSize="11"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 当前回合信息 -->
                    <Border DockPanel.Dock="Top" Background="#00000066" Padding="12"
                            CornerRadius="6" Margin="0,0,0,8">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="当前回合" Foreground="#9ca3af" FontSize="11"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentPlayer.Name, FallbackValue='-'}"
                                       Foreground="#fbbf24" FontWeight="Bold" FontSize="18"
                                       HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                <TextBlock Foreground="#86efac" FontSize="12">
                                    <Run Text="💰" />
                                    <Run Text="{Binding CurrentPlayer.Cash, StringFormat='${0:N0}'}" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock Foreground="#93c5fd" FontSize="12">
                                    <Run Text="🏦" />
                                    <Run Text="{Binding CurrentPlayer.Deposit, StringFormat='${0:N0}'}" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock Foreground="#c4b5fd" FontSize="12">
                                    <Run Text="💎" />
                                    <Run Text="{Binding CurrentPlayer.Diamonds}" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock Foreground="#fcd34d" FontSize="12">
                                    <Run Text="✨" />
                                    <Run Text="{Binding CurrentPlayer.Attraction}" FontWeight="Bold"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <Button Content="🎲 投骰子" Command="{Binding RollDiceCommand}"
                                        IsEnabled="{Binding IsMyTurn}"/>
                                <Button Content="⏭ 结束回合" Command="{Binding EndTurnCommand}"
                                        IsEnabled="{Binding IsMyTurn}"/>
                            </StackPanel>
                            <TextBlock Foreground="#a7f3d0" FontSize="14" HorizontalAlignment="Center"
                                       IsVisible="{Binding DiceValue, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <Run Text="本轮骰子:" />
                                <Run Text="{Binding DiceValue}" FontWeight="Bold" FontSize="20"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ============ 操作菜单 (Stage 3) ============ -->
                    <Border IsVisible="{Binding HasSelectedCell}"
                            Background="#1e293b" Padding="10" CornerRadius="6">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding SelectedCell.PureName, FallbackValue='已选格子'}"
                                       Foreground="#fbbf24" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Foreground="#94a3b8" FontSize="11"
                                       HorizontalAlignment="Center">
                                <Run Text="类型:" />
                                <Run Text="{Binding SelectedCell.Type}" FontWeight="Bold" Foreground="#cbd5e1"/>
                                <Run Text=" 等级:" />
                                <Run Text="{Binding SelectedCell.Level}" FontWeight="Bold" Foreground="#cbd5e1"/>
                                <Run Text=" 价格:" />
                                <Run Text="{Binding SelectedCell.Price, StringFormat='${0:N0}'}" FontWeight="Bold" Foreground="#fde68a"/>
                            </TextBlock>

                            <!-- 购买 -->
                            <Button Command="{Binding BuyPropertyCommand}"
                                    CommandParameter="{Binding SelectedCellId}"
                                    IsEnabled="{Binding CanBuy}"
                                    Background="#16a34a" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center">
                                <TextBlock Foreground="White" FontWeight="Bold">
                                    <Run Text="🛒 购买:" />
                                    <Run Text="{Binding SelectedCell.Price, StringFormat='${0:N0}'}" />
                                </TextBlock>
                            </Button>

                            <!-- 升级 -->
                            <StackPanel IsVisible="{Binding CanUpgrade}">
                                <Button Command="{Binding UpgradePropertyCommand}"
                                        CommandParameter="{Binding SelectedCellId}"
                                        Background="#ca8a04" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center">
                                    <TextBlock Foreground="White" FontWeight="Bold">
                                        <Run Text="⬆️ 升级至 Lv." />
                                        <Run Text="{Binding SelectedCell.Level}" />
                                        <Run Text="(+1)" />
                                    </TextBlock>
                                </Button>
                                <TextBlock Text="{Binding CurrentMaterialCost.Display}"
                                           Foreground="#fef3c7" FontSize="10"
                                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding UpgradeCost, StringFormat='💰 ${0:N0}'}"
                                           Foreground="#fef3c7" FontSize="10"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- 升级条件不足 -> 红色提示 -->
                            <StackPanel IsVisible="{Binding IsSelectedCellMine}">
                                <TextBlock Text="{Binding UpgradeShortage}"
                                           Foreground="#fca5a5" FontSize="10"
                                           HorizontalAlignment="Center"
                                           IsVisible="{Binding UpgradeShortage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            </StackPanel>

                            <!-- 特殊升级入口 -->
                            <Button Command="{Binding ShowSpecialUpgradeCommand}"
                                    IsVisible="{Binding CanSpecialUpgrade}"
                                    Background="#7c3aed" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center">
                                <TextBlock Foreground="White" FontWeight="Bold" Text="⭐ 选择特殊升级"/>
                            </Button>

                            <!-- 已装的特殊建筑 -->
                            <Border Background="#581c87" Padding="6" CornerRadius="4"
                                    IsVisible="{Binding SpecialUpgradeName, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Foreground="#e9d5ff" FontSize="11"
                                           HorizontalAlignment="Center">
                                    <Run Text="⭐ 当前:" />
                                    <Run Text="{Binding SpecialUpgradeName}" FontWeight="Bold"/>
                                </TextBlock>
                            </Border>

                            <!-- 出售 (自己财产) -->
                            <Button Command="{Binding SellPropertyCommand}"
                                    CommandParameter="{Binding SelectedCellId}"
                                    IsVisible="{Binding IsSelectedCellMine}"
                                    IsEnabled="{Binding CanSell}"
                                    Background="#7f1d1d" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center">
                                <TextBlock Foreground="white" FontWeight="Bold" Text="💸 出售"/>
                            </Button>

                            <!-- 关闭按钮 -->
                            <Button Command="{Binding SelectCellCommand}"
                                    CommandParameter="{Binding SelectedCellId}"
                                    Background="#374151" Margin="0,4,0,0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center">
                                <TextBlock Foreground="white" FontSize="10" Text="✕ 关闭"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- ============ 特殊升级弹层 ============ -->
            <Border Grid.Row="0" Grid.RowSpan="17" Grid.Column="0" Grid.ColumnSpan="17"
                    Background="#000000AA"
                    IsVisible="{Binding ShowSpecialUpgradePanel}">
                <Border Background="#1f2937" Padding="16" CornerRadius="8"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        MinWidth="300">
                    <StackPanel Spacing="6">
                        <TextBlock Text="⭐ 选择特殊升级" Foreground="#fbbf24"
                                   FontWeight="Bold" FontSize="16"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>

                        <ItemsControl ItemsSource="{Binding SpecialUpgradeOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:SpecialUpgradeOption">
                                    <Button Click="OnSpecialUpgradeClick"
                                            Tag="{Binding Type}"
                                            Background="#7c3aed" Margin="0,2"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left" Padding="8,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Text="{Binding Description}" Foreground="#e9d5ff" FontSize="10"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Command="{Binding HideSpecialUpgradeCommand}"
                                Background="#374151" Margin="0,8,0,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center">
                            <TextBlock Foreground="#cbd5e1" Text="✕ 取消"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</UserControl>
