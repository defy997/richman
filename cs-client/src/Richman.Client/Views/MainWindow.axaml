<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Richman.Client.ViewModels"
        xmlns:views="using:Richman.Client.Views"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Richman.Client.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="RichMan Online (C# / Avalonia)"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel LastChildFill="True">
        <!-- 顶部状态栏 -->
        <Border DockPanel.Dock="Top" Background="#1f2937" Padding="12">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" VerticalAlignment="Center">
                <TextBlock Grid.Column="0" Text="🎲 RichMan Online"
                           FontSize="20" FontWeight="Bold" Foreground="#fbbf24" Margin="0,0,16,0" />

                <TextBlock Grid.Column="2" Text="{Binding Status}"
                           Foreground="#9ca3af" VerticalAlignment="Center" Margin="0,0,12,0" />

                <TextBox Grid.Column="3" Width="220" Watermark="http://host:port"
                         Text="{Binding ServerUrl}" />
                <Button Grid.Column="4" Content="连接" Margin="8,0,0,0"
                        Command="{Binding ConnectCommand}" />
            </Grid>
        </Border>

        <!-- 主体: 通过 IsVisible 切换 -->
        <Panel>
            <views:LobbyView     DataContext="{Binding Lobby}" />
            <views:GameBoardView DataContext="{Binding GameBoard}" />
        </Panel>
    </DockPanel>
</Window>
