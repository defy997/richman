<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Richman.Client.ViewModels"
             xmlns:views="using:Richman.Client.Views"
             mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="900"
             x:Class="Richman.Client.Views.GameBoardView"
             x:DataType="vm:GameBoardViewModel">

    <Design.DataContext>
        <vm:GameBoardViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Background="#0f172a">

        <!-- 顶部状态栏 -->
        <Border Grid.Row="0" Background="#1f2937" Padding="12">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="🎲 RichMan Online"
                           FontSize="20" FontWeight="Bold" Foreground="#fbbf24" Margin="0,0,16,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                    <TextBlock Foreground="#d1d5db">
                        <Run Text="回合:" />
                        <Run Text="{Binding Store.CurrentTurn}" Foreground="#fbbf24" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBlock Foreground="#d1d5db">
                        <Run Text="当前玩家:" />
                        <Run Text="{Binding Store.CurrentPlayer.Name}" Foreground="#60a5fa" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBlock Foreground="#d1d5db">
                        <Run Text="日期:" />
                        <Run Text="{Binding Store.GameDate}" Foreground="#a78bfa"/>
                    </TextBlock>
                    <TextBlock Foreground="#d1d5db">
                        <Run Text="目标:" />
                        <Run Text="{Binding Store.TargetAssets, StringFormat='${0:N0}'}" Foreground="#fbbf24" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>

                <Button Grid.Column="2" Content="🎲 投骰子" Margin="0,0,8,0"
                        Command="{Binding RollDiceCommand}"/>
                <Button Grid.Column="3" Content="⏭ 结束回合"
                        Command="{Binding EndTurnCommand}"/>
            </Grid>
        </Border>

        <!-- 主体: 棋盘 + 侧栏 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,340">

            <!-- TabControl: 棋盘 / 股票 / 期货 -->
            <TabControl Grid.Column="0" Margin="12"
                        Background="#0f172a">
                <TabItem Header="🎲 棋盘">
                    <views:BoardView DataContext="{Binding Board}"/>
                </TabItem>
                <TabItem Header="📈 股票">
                    <views:StockView DataContext="{Binding Stock}"/>
                </TabItem>
                <TabItem Header="🛢️ 期货">
                    <views:FuturesView DataContext="{Binding Futures}"/>
                </TabItem>
                <TabItem Header="🃏 卡片">
                    <views:CardView DataContext="{Binding Cards}"/>
                </TabItem>
            </TabControl>

            <!-- 侧栏: 玩家 + 银行 + 消息 + 当前选中格 -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" Margin="0,12,12,12">

                <!-- 玩家列表 -->
                <Border Grid.Row="0" Background="#1f2937" Padding="12" CornerRadius="8" Margin="0,0,0,8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="👥 玩家" FontWeight="Bold"
                                   Foreground="#fbbf24" FontSize="16" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Store.Players}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#374151" CornerRadius="4" Padding="8" Margin="0,2">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Ellipse Grid.Column="0" Width="14" Height="14"
                                                     Fill="{Binding Color}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{Binding Name}" Foreground="White"
                                                               FontWeight="Bold"/>
                                                    <TextBlock Text="(AI)" Foreground="#9ca3af" FontSize="10"
                                                               IsVisible="{Binding IsAI}"/>
                                                    <TextBlock Text="(当前)" Foreground="#fbbf24" FontSize="10"
                                                               IsVisible="{Binding IsCurrentTurn}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Foreground="#86efac" FontSize="10">
                                                        <Run Text="💰" />
                                                        <Run Text="{Binding Cash, StringFormat='${0:N0}'}"/>
                                                    </TextBlock>
                                                    <TextBlock Foreground="#93c5fd" FontSize="10">
                                                        <Run Text="🏦" />
                                                        <Run Text="{Binding Deposit, StringFormat='${0:N0}'}"/>
                                                    </TextBlock>
                                                    <TextBlock Foreground="#c4b5fd" FontSize="10">
                                                        <Run Text="💎" />
                                                        <Run Text="{Binding Diamonds}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Position}"
                                                       Foreground="#9ca3af" FontSize="11"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!-- 银行面板 (Phase 4) -->
                <views:BankView Grid.Row="1" DataContext="{Binding Bank}" Margin="0,0,0,8"/>

                <!-- 消息日志 -->
                <Border Grid.Row="2" Background="#1f2937" Padding="12" CornerRadius="8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="📜 消息日志" FontWeight="Bold"
                                   Foreground="#fbbf24" FontSize="16" Margin="0,0,0,8"/>
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Store.Messages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#d1d5db"
                                                   FontSize="11" TextWrapping="Wrap" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- 错误提示 -->
                <Border Grid.Row="3" Background="#7f1d1d" Padding="8" CornerRadius="6"
                        IsVisible="{Binding Store.LastError, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Margin="0,8,0,0">
                    <TextBlock Text="{Binding Store.LastError}" Foreground="#fecaca"
                               TextWrapping="Wrap" FontSize="11"/>
                </Border>
            </Grid>
        </Grid>

        <!-- 底部 -->
        <Border Grid.Row="2" Background="#1f2937" Padding="8">
            <TextBlock Text="股票 / 期货 / 银行 / 卡片 / 拍卖 面板将在 Phase 3+ 接入"
                       Foreground="#9ca3af" HorizontalAlignment="Center" FontSize="11"/>
        </Border>
    </Grid>
</UserControl>
