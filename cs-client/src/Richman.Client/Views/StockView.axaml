<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Richman.Client.ViewModels"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="Richman.Client.Views.StockView"
             x:DataType="vm:StockViewModel">

    <Design.DataContext>
        <vm:StockViewModel />
    </Design.DataContext>

    <Border Background="#0f172a" Padding="12">
        <Grid ColumnDefinitions="260,*" RowDefinitions="*,Auto">

            <!-- 左侧: 板块 + 股票列表 -->
            <DockPanel Grid.Column="0" Grid.Row="0" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Text="📈 股票市场" FontWeight="Bold"
                           Foreground="#fbbf24" FontSize="16" Margin="0,0,0,8"/>

                <ComboBox DockPanel.Dock="Top" Margin="0,0,0,8"
                          ItemsSource="{Binding Sectors}"
                          SelectedItem="{Binding SelectedSector}"
                          PlaceholderText="选择板块"/>

                <ListBox ItemsSource="{Binding FilteredStocks}"
                         SelectedItem="{Binding SelectedStockSymbol, Mode=TwoWay}"
                         Background="#1f2937">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" Margin="4">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Foreground="#9ca3af" FontSize="10">
                                        <Run Text="{Binding Symbol}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Sector}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Price, StringFormat=${0:N2}}"
                                               Foreground="#fde68a" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Foreground="#10b981" FontSize="10"
                                               IsVisible="{Binding Change, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <Run Text="▲" />
                                        <Run Text="{Binding Change, StringFormat={}{0:P2}}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- 右侧: K 线 + 成交量 + 交易面板 -->
            <Grid Grid.Column="1" Grid.Row="0" RowDefinitions="Auto,*,Auto">

                <!-- 股票信息头 -->
                <Border Grid.Row="0" Background="#1f2937" Padding="12" CornerRadius="6" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Foreground="White" FontSize="20" FontWeight="Bold">
                                <Run Text="{Binding SelectedStock.Name, FallbackValue='-'}" />
                                <Run Text=" "/>
                                <Run Text="{Binding SelectedStock.Symbol}" Foreground="#9ca3af" FontSize="14"/>
                            </TextBlock>
                            <TextBlock Foreground="#fde68a" FontSize="28" FontWeight="Bold">
                                <Run Text="{Binding SelectedStock.Price, StringFormat=${0:N2}}" />
                                <Run Text="{Binding SelectedStock.Change, StringFormat='  {0:+0.00;-0.00+0.00;0.00}'}" Foreground="#10b981"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Foreground="#86efac" FontSize="12">
                                <Run Text="持仓数量:" />
                                <Run Text="{Binding MyHoldingQuantity}" FontWeight="Bold" />
                            </TextBlock>
                            <TextBlock Foreground="#93c5fd" FontSize="12">
                                <Run Text="平均成本:" />
                                <Run Text="{Binding MyAvgCost, StringFormat=${0:N2}}" FontWeight="Bold" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- K 线 + 成交量 -->
                <Grid Grid.Row="1" RowDefinitions="3*,1*">
                    <Border Grid.Row="0" Background="#1f2937" Padding="8" CornerRadius="6">
                        <lvc:CartesianChart
                            Series="{Binding PriceSeries}"
                            XAxes="{Binding XAxes}"
                            YAxes="{Binding YAxes}"
                            ZoomMode="X"
                            TooltipPosition="Top"/>
                    </Border>
                    <Border Grid.Row="1" Background="#1f2937" Padding="8" CornerRadius="6" Margin="0,4,0,0">
                        <lvc:CartesianChart
                            Series="{Binding VolumeSeries}"
                            XAxes="{Binding VolumeXAxes}"
                            YAxes="{Binding VolumeYAxes}"/>
                    </Border>
                </Grid>

                <!-- 交易面板 -->
                <Border Grid.Row="2" Background="#1f2937" Padding="10" CornerRadius="6" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="数量" Foreground="#9ca3af" FontSize="10"/>
                            <NumericUpDown Minimum="1" Maximum="999999" Value="{Binding TradeQuantity}" Width="100"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="杠杆 (1-3, 仅买)" Foreground="#9ca3af" FontSize="10"/>
                            <NumericUpDown Minimum="1" Maximum="3" Value="{Binding TradeLeverage}" Width="80"/>
                        </StackPanel>
                        <Button Grid.Row="1" Grid.Column="0" Content="🟢 买入"
                                Command="{Binding BuyCommand}" Background="#16a34a" Margin="0,0,4,0"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="🔴 卖出"
                                Command="{Binding SellCommand}" Background="#dc2626" Margin="0,0,4,0"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="⬇️ 做空"
                                Command="{Binding ShortCommand}" Background="#7c3aed" Margin="0,0,4,0"/>
                        <Button Grid.Row="1" Grid.Column="3" Content="⬆️ 平仓"
                                Command="{Binding CoverCommand}" Background="#0891b2" Margin="0,0,4,0"/>
                        <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="9"
                                   Foreground="#9ca3af" FontSize="10" VerticalAlignment="Center">
                            <Run Text="交易从存款扣款/入账"/>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
