<Window x:Class="Richman.Client.Modals.MarketModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🛒 市场" Height="600" Width="750"
        WindowStartupLocation="CenterScreen"
        Background="#1a1b26">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="🛒" FontSize="28"/>
            <TextBlock Text="商品市场" Foreground="White" FontSize="22" FontWeight="Bold" Margin="10,5,0,0"/>
            <Border x:Name="StatusBadge" Background="#22c55e" CornerRadius="4" Padding="10,4" Margin="15,8,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="在市场中" Foreground="White" FontSize="11"/>
            </Border>
            <TextBlock x:Name="DayText" Text="第1天" Foreground="#565f89" FontSize="11" Margin="10,10,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="MacroText" Text="宏观:" Foreground="#7aa2f7" FontSize="10" Margin="10,2,0,0" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Margin="10,2,0,0">
                <TextBlock x:Name="BuildingSectorText" Text="建材" Foreground="#bb9af7" FontSize="10" Margin="0,0,10,0"/>
                <TextBlock x:Name="PreciousSectorText" Text="贵金属" Foreground="#e0af68" FontSize="10"/>
            </StackPanel>
        </StackPanel>

        <!-- My Resources -->
        <Border Grid.Row="1" Background="#24283b" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="💵 现金" Foreground="#565f89" FontSize="10"/>
                    <TextBlock x:Name="CashText" Text="$0" Foreground="#22c55e" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="💎 钻石" Foreground="#565f89" FontSize="10"/>
                    <TextBlock x:Name="DiamondText" Text="0" Foreground="#bb9af7" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="🏗️ 水泥" Foreground="#565f89" FontSize="10"/>
                    <TextBlock x:Name="CementText" Text="0" Foreground="#7dcfff" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="🔩 钢材" Foreground="#565f89" FontSize="10"/>
                    <TextBlock x:Name="SteelText" Text="0" Foreground="#9ece6a" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Goods List -->
        <Border Grid.Row="2" Background="#24283b" CornerRadius="6" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="商品" Foreground="#7aa2f7" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="当前价格" Foreground="#7aa2f7" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text="涨跌" Foreground="#7aa2f7" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="数量" Foreground="#7aa2f7" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="操作" Foreground="#7aa2f7" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="GoodsList"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Background="#24283b" CornerRadius="6" Padding="12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock x:Name="TotalText" Text="选中商品合计: $0" Foreground="#e0af68" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock Text="💡 市场说明: 建材价格随通胀浮动，越早买入越便宜。钻石属于稀缺商品。" Foreground="#565f89" FontSize="10" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>