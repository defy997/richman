<Window x:Class="Richman.Client.Modals.FuturesModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="期货交易所" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#1a1b26">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Trading Area -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
            <StackPanel>
                <!-- My Inventory -->
                <Border Background="#24283b" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="📦 我的库存" Foreground="#7aa2f7" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="💎" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DiamondCount" Text="0" Foreground="#f7768e" FontSize="12" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="🧱" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CementCount" Text="0" Foreground="#9ece6a" FontSize="12" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <TextBlock Text="🔩" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SteelCount" Text="0" Foreground="#bb9af7" FontSize="12" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="💰 存款:" Foreground="#565f89" FontSize="10"/>
                                <TextBlock x:Name="DepositText" Text="$0" Foreground="#9ece6a" FontSize="10" FontWeight="Bold" Margin="4,0,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="💵 现金:" Foreground="#565f89" FontSize="10"/>
                                <TextBlock x:Name="CashText" Text="$0" Foreground="#9ece6a" FontSize="10" FontWeight="Bold" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Category Filter -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button x:Name="FilterAll" Content="全部" Click="FilterCategory_Click" Tag="all" Margin="0,0,5,0"
                            Background="#7aa2f7" Foreground="White" BorderThickness="0" Padding="12,6" FontSize="11" FontWeight="Bold"/>
                    <Button x:Name="FilterPrecious" Content="贵金属" Click="FilterCategory_Click" Tag="precious" Margin="0,0,5,0"
                            Background="#3d4148" Foreground="White" BorderThickness="0" Padding="12,6" FontSize="11"/>
                    <Button x:Name="FilterMaterial" Content="建材" Click="FilterCategory_Click" Tag="material" Margin="0,0,5,0"
                            Background="#3d4148" Foreground="White" BorderThickness="0" Padding="12,6" FontSize="11"/>
                    <Button x:Name="FilterEnergy" Content="能源" Click="FilterCategory_Click" Tag="energy" Margin="0,0,5,0"
                            Background="#3d4148" Foreground="White" BorderThickness="0" Padding="12,6" FontSize="11"/>
                    <Button x:Name="FilterAgriculture" Content="农产品" Click="FilterCategory_Click" Tag="agriculture"
                            Background="#3d4148" Foreground="White" BorderThickness="0" Padding="12,6" FontSize="11"/>
                </StackPanel>

                <!-- Futures Grid -->
                <ItemsControl x:Name="FuturesGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="170" CornerRadius="8" Padding="10" Margin="5" Cursor="Hand" MouseLeftButtonDown="SelectFutures_Click"
                                    BorderBrush="#3d4148" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#3d4148" Offset="0"/>
                                        <GradientStop Color="#2a2e3f" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" FontSize="22"/>
                                            <Border Background="#00000066" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ShortCode}" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Symbol}" Foreground="#565f89" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                    <Grid Margin="0,6,0,0">
                                        <TextBlock Text="{Binding PriceText}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="{Binding ChangeText}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding StatusText}" Foreground="#7dcfff" FontSize="9"/>
                                        <TextBlock Text=" · " Foreground="#565f89" FontSize="9"/>
                                        <TextBlock Text="{Binding ExpiryText}" Foreground="#565f89" FontSize="9"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Selected Futures Detail -->
                <Border x:Name="FuturesDetail" Background="#24283b" CornerRadius="8" Padding="15" Margin="0,10,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <!-- Header -->
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="SelectedIcon" Text="🛢️" FontSize="28"/>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock x:Name="SelectedName" Text="黄金期货" Foreground="White" FontWeight="Bold" FontSize="15"/>
                                    <TextBlock x:Name="SelectedInfo" Text="基础价 $1500 · 贵金属 · 波动率 2.5%" Foreground="#565f89" FontSize="10"/>
                                    <TextBlock x:Name="SelectedExpiry" Text="📅 合约到期 30 天后" Foreground="#7aa2f7" FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock x:Name="SelectedPrice" Text="$1500" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="SelectedChange" Text="+0.5%" Foreground="#9ece6a" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <!-- Event Message -->
                        <Border x:Name="EventBorder" Background="#3d3d5c" CornerRadius="4" Padding="8" Margin="0,0,0,12" Visibility="Collapsed">
                            <TextBlock x:Name="EventText" Text="📢 有重大事件" Foreground="#f7768e" FontSize="11"/>
                        </Border>

                        <!-- K-Line Chart -->
                        <Border Background="#0f0f1a" CornerRadius="4" Padding="5" Margin="0,0,0,12">
                            <oxy:PlotView x:Name="FuturesChart" Height="200"/>
                        </Border>

                        <!-- My Holdings -->
                        <Border x:Name="MyHoldingBorder" Background="#1a1b26" CornerRadius="4" Padding="10" Margin="0,0,0,12" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="📋 我的持仓" Foreground="#7aa2f7" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel x:Name="LongPositionPanel" Grid.Column="0" Visibility="Collapsed">
                                        <TextBlock Text="多头持仓" Foreground="#9ece6a" FontSize="10"/>
                                        <TextBlock x:Name="LongQtyText" Text="0 手 @ $0" Foreground="White" FontSize="11"/>
                                        <TextBlock x:Name="LongPnlText" Text="盈亏: $0" Foreground="#9ece6a" FontSize="10"/>
                                    </StackPanel>
                                    <StackPanel x:Name="ShortPositionPanel" Grid.Column="1" Visibility="Collapsed">
                                        <TextBlock Text="空头持仓" Foreground="#f7768e" FontSize="10"/>
                                        <TextBlock x:Name="ShortQtyText" Text="0 手 @ $0" Foreground="White" FontSize="11"/>
                                        <TextBlock x:Name="ShortPnlText" Text="盈亏: $0" Foreground="#f7768e" FontSize="10"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="TotalPnlText" Text="总浮动盈亏: $0" Foreground="White" FontSize="12" FontWeight="Bold" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="BuyBtn" Content="做多" Click="SetAction_Click" Tag="buy" Margin="0,0,3,0"
                                    Background="#196627" Foreground="White" BorderThickness="0" Padding="8,8" FontSize="12" FontWeight="Bold"/>
                            <Button Grid.Column="1" x:Name="SellBtn" Content="做空" Click="SetAction_Click" Tag="sell" Margin="3,0"
                                    Background="#3d3d5c" Foreground="White" BorderThickness="0" Padding="8,8" FontSize="12" FontWeight="Bold"/>
                            <Button Grid.Column="2" x:Name="CloseBtn" Content="平仓" Click="SetAction_Click" Tag="close" Margin="3,0"
                                    Background="#3d3d5c" Foreground="White" BorderThickness="0" Padding="8,8" FontSize="12" FontWeight="Bold"/>
                            <Button Grid.Column="3" x:Name="DeliveryBtn" Content="交割" Click="SetAction_Click" Tag="delivery" Margin="3,0"
                                    Background="#3d3d5c" Foreground="White" BorderThickness="0" Padding="8,8" FontSize="12" FontWeight="Bold"/>
                            <Button Grid.Column="4" x:Name="ExchangeBtn" Content="兑换" Click="SetAction_Click" Tag="exchange" Margin="3,0,0,0"
                                    Background="#3d3d5c" Foreground="White" BorderThickness="0" Padding="8,8" FontSize="12" FontWeight="Bold"/>
                        </Grid>

                        <!-- Leverage -->
                        <StackPanel x:Name="LeveragePanel" Margin="0,0,0,10">
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="⚡ 杠杆倍数" Foreground="#565f89" FontSize="10"/>
                                <TextBlock x:Name="LeverageText" Text="1x" Foreground="#7dcfff" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="1x" Tag="1" Click="SetLeverage_Click" Margin="0,0,3,0"
                                        Background="#196627" Foreground="White" BorderThickness="0" Padding="5,5"/>
                                <Button Grid.Column="1" Content="2x" Tag="2" Click="SetLeverage_Click" Margin="3,0"
                                        Background="#3d4148" Foreground="White" BorderThickness="0" Padding="5,5"/>
                                <Button Grid.Column="2" Content="5x" Tag="5" Click="SetLeverage_Click" Margin="3,0"
                                        Background="#3d4148" Foreground="White" BorderThickness="0" Padding="5,5"/>
                                <Button Grid.Column="3" Content="7x" Tag="7" Click="SetLeverage_Click" Margin="3,0"
                                        Background="#3d4148" Foreground="White" BorderThickness="0" Padding="5,5"/>
                                <Button Grid.Column="4" Content="10x" Tag="10" Click="SetLeverage_Click" Margin="3,0,0,0"
                                        Background="#3d4148" Foreground="White" BorderThickness="0" Padding="5,5"/>
                            </Grid>
                        </StackPanel>

                        <!-- Quantity -->
                        <StackPanel x:Name="QuantityPanel" Margin="0,0,0,10">
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="数量（手）" Foreground="#565f89" FontSize="10"/>
                                <TextBlock x:Name="QuantityText" Text="1" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="1" Tag="1" Click="SetQuantity_Click" Margin="0,0,3,0"
                                        Background="#7aa2f7" Foreground="White" BorderThickness="0" Padding="5,5"/>
                                <Button Grid.Column="1" Content="2" Tag="2" Click="SetQuantity_Click" Margin="3,0"
                                        Background="#3d4148" Foreground="White" BorderThickness="0" Padding="5,5"/>
                                <Button Grid.Column="2" Content="5" Tag="5" Click="SetQuantity_Click" Margin="3,0"
                                        Background="#3d4148" Foreground="White" BorderThickness="0" Padding="5,5"/>
                                <Button Grid.Column="3" Content="10" Tag="10" Click="SetQuantity_Click" Margin="3,0"
                                        Background="#3d4148" Foreground="White" BorderThickness="0" Padding="5,5"/>
                                <Button Grid.Column="4" Content="20" Tag="20" Click="SetQuantity_Click" Margin="3,0,0,0"
                                        Background="#3d4148" Foreground="White" BorderThickness="0" Padding="5,5"/>
                            </Grid>
                        </StackPanel>

                        <!-- Trade Info -->
                        <Border Background="#0f0f1a" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="名义价值" Foreground="#565f89" FontSize="10"/>
                                    <TextBlock x:Name="CostText" Text="$0" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <TextBlock x:Name="MarginLabel" Text="占用资金" Foreground="#565f89" FontSize="10"/>
                                    <TextBlock x:Name="MarginText" Text="$0" Foreground="#7dcfff" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <TextBlock Text="手续费(2%)" Foreground="#565f89" FontSize="10"/>
                                    <TextBlock x:Name="FeeText" Text="$0" Foreground="#565f89" FontSize="10" HorizontalAlignment="Right"/>
                                </Grid>
                                <Border BorderThickness="0,1,0,0" BorderBrush="#3d4148" Margin="0,6,0,0" Padding="0,6,0,0">
                                    <Grid>
                                        <TextBlock Text="实际冻结(从存款)" Foreground="#f7768e" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock x:Name="FrozenText" Text="$0" Foreground="#f7768e" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <!-- Delivery Info - Only visible for materials -->
                                <Border x:Name="DeliveryInfoPanel" Visibility="Collapsed" BorderThickness="0,1,0,0" BorderBrush="#3d4148" Margin="0,6,0,0" Padding="0,6,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="做多可交割" Foreground="#e0af68" FontSize="10"/>
                                            <TextBlock x:Name="LongDeliverableText" Text="0 手" Foreground="#e0af68" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <TextBlock x:Name="LongDeliveryDesc" Text="(需支付 $0 + 释放保证金)" Foreground="#565f89" FontSize="9" Margin="0,2,0,0"/>
                                        <Grid Margin="0,4,0,0">
                                            <TextBlock Text="做空需交付" Foreground="#bb9af7" FontSize="10"/>
                                            <TextBlock x:Name="ShortDeliveryText" Text="0 手" Foreground="#bb9af7" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <TextBlock x:Name="ShortDeliveryDesc" Text="(需持有实物，可获得 $0)" Foreground="#565f89" FontSize="9" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Execute Button -->
                        <Button x:Name="ExecuteBtn" Content="✅ 做多 1 手（1x杠杆）" Click="ExecuteTrade_Click"
                                Background="#196627" Foreground="White" BorderThickness="0" Padding="12,10" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Help Text -->
                <Border Background="#24283b" CornerRadius="4" Padding="12" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="💡 玩法说明" Foreground="#7aa2f7" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock Text="• 双向交易：做多看涨、做空看跌，涨跌都能赚钱" Foreground="#565f89" FontSize="10" TextWrapping="Wrap"/>
                        <TextBlock Text="• T+0：当日开仓可当日平仓，无次数限制" Foreground="#565f89" FontSize="10" TextWrapping="Wrap"/>
                        <TextBlock Text="• 杠杆机制：1~10x杠杆，小资金撬动大合约" Foreground="#565f89" FontSize="10" TextWrapping="Wrap"/>
                        <TextBlock Text="• 事件需站在交易所才能查看详情" Foreground="#565f89" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Right: Holdings -->
        <Border Grid.Column="1" Background="#24283b" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="📋 玩家持仓" Foreground="#7aa2f7" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="HoldingsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1a1b26" CornerRadius="4" Padding="8" Margin="0,0,0,8"
                                        BorderThickness="3,0,0,0" BorderBrush="{Binding BorderBrush}">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="10" Height="10" Fill="{Binding Color}"/>
                                                <TextBlock Text="{Binding PlayerName}" Foreground="{Binding Color}" FontWeight="Bold" FontSize="11" Margin="5,0"/>
                                                <TextBlock Text="我" Visibility="{Binding IsMe}" Foreground="#f7768e" FontSize="9" FontWeight="Bold"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding PnlText}" Foreground="{Binding PnlColor}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <TextBlock Text="{Binding PositionText}" Foreground="#9aa5ce" FontSize="10" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
