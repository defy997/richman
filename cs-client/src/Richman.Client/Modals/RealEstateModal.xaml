<Window x:Class="Richman.Client.Modals.RealEstateModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🏛️ 房地产" Height="650" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#1e293b">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Lists -->
        <Grid Grid.Column="0" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 拍卖商业用地 -->
            <Border Grid.Row="0" Background="#78350f" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🔨" FontSize="20"/>
                        <TextBlock Text="商业用地拍卖（每7天一轮，暗标）" Foreground="#fbbf24" FontSize="16" FontWeight="Bold" Margin="8,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel x:Name="AuctionList">
                        <Border Background="#451a03" CornerRadius="4" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" x:Name="AuctionTitle" Foreground="#fbbf24" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Grid.Row="1" x:Name="AuctionReserveText" Foreground="#92400e" FontSize="11" Margin="0,4,0,0"/>
                                <TextBlock Grid.Row="2" x:Name="MyBidStatus" Foreground="#fbbf24" FontSize="11" FontWeight="Bold" Margin="0,4,0,8"/>
                                <Button Grid.Row="3" Content="📝 提交暗标出价" Click="AuctionBidBtn_Click"
                                        Background="#f59e0b" Foreground="White" BorderThickness="0" Padding="14,8" FontWeight="Bold" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="NoAuctionText" Text="📭 本轮暂无拍卖（每7天一轮）" Foreground="#92400e" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 我的地图地皮 -->
            <Border Grid.Row="1" Background="#0f3460" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="🏘️" FontSize="20"/>
                        <TextBlock x:Name="MyPropertiesTitle" Text="我的地图地皮 (0)" Foreground="#22c55e" FontSize="16" FontWeight="Bold" Margin="8,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ScrollViewer MaxHeight="180">
                        <ItemsControl x:Name="MyPropertiesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1e293b" CornerRadius="4" Padding="10" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold"/>
                                                <TextBlock Foreground="#64748b" FontSize="10">
                                                    Lv.<Run Text="{Binding Level}"/> · $<Run Text="{Binding BasePrice, StringFormat=N0}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="升级" Tag="{Binding Id}" Click="Upgrade_Click"
                                                    Background="#f59e0b" Foreground="White" BorderThickness="0" Padding="10,5" Margin="5,0"/>
                                            <Button Grid.Column="2" Content="卖出" Tag="{Binding Id}" Click="Sell_Click"
                                                    Background="#64748b" Foreground="White" BorderThickness="0" Padding="10,5"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- 我的商业用地（拍得） -->
            <Border Grid.Row="2" Background="#7c2d12" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="🏙️" FontSize="20"/>
                        <TextBlock x:Name="MyCommercialTitle" Text="我的商业用地 (0)" Foreground="#fed7aa" FontSize="16" FontWeight="Bold" Margin="8,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="💡 商业用地可随时以半价升级（每次升级成本翻倍）" Foreground="#fb923c" FontSize="10" Margin="0,0,0,8"/>

                    <ScrollViewer MaxHeight="120">
                        <ItemsControl x:Name="MyCommercialList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#431407" CornerRadius="4" Padding="10" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" Foreground="#fed7aa" FontWeight="Bold"/>
                                                <TextBlock Foreground="#94a3b8" FontSize="10">
                                                    Lv.<Run Text="{Binding Level}"/> · 成交价 $<Run Text="{Binding FinalPrice, StringFormat=N0}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="⬆️ 升级（半价）" Tag="{Binding Id}" Click="UpgradeCommercial_Click"
                                                    Background="#fb923c" Foreground="White" BorderThickness="0" Padding="10,5"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- 所有玩家地皮 -->
            <Border Grid.Row="3" Background="#0f3460" CornerRadius="8" Padding="15">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="👥" FontSize="20"/>
                        <TextBlock Text="玩家地皮" Foreground="#94a3b8" FontSize="16" FontWeight="Bold" Margin="8,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ScrollViewer>
                        <ItemsControl x:Name="AllPlayersList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="2,0,0,0" Padding="8" Margin="0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="10" Height="10" Fill="{Binding Color}"/>
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" Margin="5,0"/>
                                            <TextBlock Foreground="#64748b" FontSize="10" VerticalAlignment="Center">
                                                <Run Text="{Binding Properties.Count, Mode=OneWay}"/>块
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Right: Sell Center -->
        <Border Grid.Column="1" Background="#0f3460" CornerRadius="8" Padding="15">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="🏛️" FontSize="20"/>
                    <TextBlock Text="房地产交易中心" Foreground="#a855f7" FontSize="16" FontWeight="Bold" Margin="8,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="将地皮卖给交易所，按70%回收" Foreground="#64748b" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,15"/>
                <Border Background="#1e293b" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                    <TextBlock x:Name="SellStatusText" Text="需要站在房地产交易中心" Foreground="#ef4444" FontSize="11"/>
                </Border>
                <ItemsControl x:Name="SellablePropertiesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1e293b" CornerRadius="4" Padding="10" Margin="0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold"/>
                                        <TextBlock Foreground="#22c55e" FontSize="10">
                                            可获 $<Run Text="{Binding BasePrice, StringFormat=N0}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="卖给交易所" Tag="{Binding Id}" Click="SellToCenter_Click"
                                            Background="#a855f7" Foreground="White" BorderThickness="0" Padding="8,5"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</Window>
