<Window x:Class="Richman.Client.Modals.BankModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🏦 银行" Height="550" Width="550"
        WindowStartupLocation="CenterScreen"
        Background="#1e293b">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="🏦" FontSize="24"/>
            <TextBlock Text="银行" Foreground="White" FontSize="24" FontWeight="Bold" Margin="10,0"/>
            <Border x:Name="BankStatusBadge" Background="#22c55e" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                <TextBlock x:Name="BankStatusText" Text="在银行" Foreground="White" FontSize="11"/>
            </Border>
        </StackPanel>

        <!-- Balance Display -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0f3460" CornerRadius="8" Padding="15" Margin="0,0,5,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="💵 现金" Foreground="#94a3b8" FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="CashText" Text="$50,000" Foreground="#22c55e" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#0f3460" CornerRadius="8" Padding="15" Margin="5,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🏦 存款" Foreground="#94a3b8" FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DepositText" Text="$50,000" Foreground="#3b82f6" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#0f3460" CornerRadius="8" Padding="15" Margin="5,0,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="💳 贷款" Foreground="#94a3b8" FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LoanText" Text="$0" Foreground="#ef4444" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Deposit/Withdraw Section -->
        <Border Grid.Row="2" Background="#0f3460" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="💱 现金 ↔ 存款" Foreground="#3b82f6" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="1K" Tag="1000" Click="QuickAmount_Click" 
                            Background="#334155" Foreground="White" BorderThickness="0" Padding="8,6"/>
                    <Button Grid.Column="1" Content="5K" Tag="5000" Click="QuickAmount_Click" 
                            Background="#334155" Foreground="White" BorderThickness="0" Padding="8,6" Margin="5,0"/>
                    <Button Grid.Column="2" Content="10K" Tag="10000" Click="QuickAmount_Click" 
                            Background="#334155" Foreground="White" BorderThickness="0" Padding="8,6" Margin="5,0"/>
                    <Button Grid.Column="3" Content="50K" Tag="50000" Click="QuickAmount_Click" 
                            Background="#334155" Foreground="White" BorderThickness="0" Padding="8,6" Margin="5,0,0,0"/>
                </Grid>

                <TextBox x:Name="AmountBox" Text="" Background="#1e293b" Foreground="White" 
                         BorderBrush="#475569" Padding="12,8" FontSize="14" Margin="0,0,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="💰 存钱" Click="Deposit_Click" Margin="0,0,5,0"
                            Background="#3b82f6" Foreground="White" BorderThickness="0" Padding="15,10" FontSize="14" FontWeight="Bold"/>
                    <Button Grid.Column="1" Content="💵 取钱" Click="Withdraw_Click" Margin="5,0,0,0"
                            Background="#22c55e" Foreground="White" BorderThickness="0" Padding="15,10" FontSize="14" FontWeight="Bold"/>
                </Grid>

                <TextBlock Text="手续费 1%" Foreground="#64748b" FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- Loan Section -->
        <Border Grid.Row="3" Background="#0f3460" CornerRadius="8" Padding="15">
            <StackPanel>
                <TextBlock Text="💰 贷款 (月利率5%，30天到期)" Foreground="#ef4444" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="可贷额度: " Foreground="#94a3b8" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="MaxLoanText" Grid.Column="1" Text="$0" Foreground="#22c55e" FontSize="12" FontWeight="Bold"/>
                </Grid>

                <Button Content="📋 贷款" Click="TakeLoan_Click"
                        Background="#ef4444" Foreground="White" BorderThickness="0" Padding="15,10" FontSize="14" FontWeight="Bold" HorizontalAlignment="Stretch"/>

                <TextBlock Text="* 需要拥有至少1块地皮才能贷款" Foreground="#64748b" FontSize="10" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
