<Window x:Class="Richman.Client.Modals.StockModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="📈 股票市场" Height="780" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#1e293b">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tonghuashun Banner -->
        <Border x:Name="TonghuashunBanner" Grid.Row="0" Background="#1d4ed8" Padding="12" Visibility="Collapsed">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📱" FontSize="20" VerticalAlignment="Center"/>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="股票交易所特供：同花顺软件" Foreground="White" FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="购买后可永久查看所有股票/期货利好利空消息" Foreground="#93c5fd" FontSize="10"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="购买 ($20,000,000)" HorizontalAlignment="Right" Click="BuyTonghuashun_Click"
                        Background="#fbbf24" Foreground="#0f172a" BorderThickness="0" Padding="16,8" FontWeight="Bold"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="128"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Sector List -->
            <Border Grid.Column="0" Background="#0f172a" BorderBrush="#374151" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="板块" Foreground="#6b7280" FontSize="11" Padding="12,10"/>

                    <ListBox Grid.Row="1" x:Name="SectorList" Background="Transparent" BorderThickness="0"
                             SelectionChanged="SectorList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" Padding="12,8">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#f43f5e"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#374151"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#d1d5db" FontSize="11"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Middle: Stock List -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Background="#0f172a" Margin="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="代码" Foreground="#6b7280" FontSize="10" FontWeight="Bold" Padding="12,8"/>
                    <TextBlock Grid.Column="1" Text="名称" Foreground="#6b7280" FontSize="10" FontWeight="Bold" Padding="8,8"/>
                    <TextBlock Grid.Column="2" Text="现价" Foreground="#6b7280" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" Padding="8,8"/>
                    <TextBlock Grid.Column="3" Text="涨跌" Foreground="#6b7280" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" Padding="8,8"/>
                    <TextBlock Grid.Column="4" Text="状态" Foreground="#6b7280" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" Padding="8,8"/>
                    <TextBlock Grid.Column="5" Text="持仓" Foreground="#6b7280" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" Padding="8,8"/>
                </Grid>

                <!-- Stock List -->
                <ListBox Grid.Row="1" x:Name="StockList" Background="Transparent" BorderThickness="0"
                         SelectionChanged="StockList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" BorderBrush="#1f2937" BorderThickness="0,0,0,1" Padding="12,8" Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#f43f5e4d"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#37415180"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Symbol}" Foreground="#9ca3af" FontSize="11"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding PriceText}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="{Binding ChangeText}" FontSize="11" HorizontalAlignment="Right">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#22c55e"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDown}" Value="True">
                                                    <Setter Property="Foreground" Value="#ef4444"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="4" Text="{Binding StatusText}" FontSize="10" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="5" Text="{Binding HoldingText}" Foreground="#6b7280" FontSize="10" HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- News Bar (always visible: shows per-stock News when present, else market sentiment) -->
                <Border x:Name="NewsBar" Grid.Row="2" Background="#0f172a" Padding="12,8">
                    <TextBlock x:Name="NewsText" Text="" Foreground="#fbbf24" FontSize="11"/>
                </Border>
            </Grid>

            <!-- Right: Detail Panel -->
            <Border Grid.Column="2" Background="#0f172a" BorderBrush="#374151" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#1e293b" Padding="12,10">
                        <Grid>
                            <TextBlock Text="股票详情" Foreground="#d1d5db" FontSize="11" FontWeight="Bold"/>
                            <Button Content="×" HorizontalAlignment="Right" Click="Close_Click"
                                    Background="#374151" Foreground="#d1d5db" BorderThickness="0" Width="24" Height="24" FontSize="14"/>
                        </Grid>
                    </Border>

                    <!-- Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DetailPanel" Visibility="Collapsed" Margin="12">
                            <!-- Stock Info -->
                            <StackPanel>
                                <TextBlock x:Name="DetailName" Text="" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock x:Name="DetailPrice" Text="$0" Foreground="White" FontSize="24" FontWeight="Bold"/>
                                    <TextBlock x:Name="DetailChange" Text="+0%" FontSize="14" Margin="10,0,0,4" VerticalAlignment="Bottom">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#22c55e"/>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock x:Name="DetailInfo" Text="" Foreground="#6b7280" FontSize="11" Margin="0,4,0,0"/>
                                <TextBlock x:Name="DetailEvent" Text="" Foreground="#f97316" FontSize="11" Margin="0,4,0,0" Visibility="Collapsed"/>
                            </StackPanel>

                            <!-- News: per-stock news shown in detail panel, market sentiment in bottom bar -->
                            <TextBlock x:Name="DetailNews" Text="" Foreground="#fbbf24" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                            <!-- K-Line Chart -->
                            <Border Background="#0a0a0f" CornerRadius="6" Margin="0,12,0,0">
                                <Grid Height="320">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="160"/>
                                        <RowDefinition Height="38"/>
                                        <RowDefinition Height="45"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- K线 + MA -->
                                    <oxy:PlotView x:Name="KLineChart" Grid.Row="0" Background="Transparent"/>

                                    <!-- 成交量 -->
                                    <Grid Grid.Row="1" Margin="0,2,0,0">
                                        <TextBlock Text="成交量" Foreground="#6b7280" FontSize="9" Margin="8,0"/>
                                        <oxy:PlotView x:Name="VolumeChart" Grid.Row="1" Background="Transparent" Height="38"/>
                                    </Grid>

                                    <!-- MACD -->
                                    <Grid Grid.Row="2" Margin="0,2,0,0">
                                        <TextBlock Text="MACD" Foreground="#6b7280" FontSize="9" Margin="8,0"/>
                                        <oxy:PlotView x:Name="MACDChart" Grid.Row="2" Background="Transparent" Height="45"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Player Holdings -->
                            <TextBlock Text="玩家持仓" Foreground="#6b7280" FontSize="10" Margin="0,12,0,6"/>
                            <ItemsControl x:Name="PlayerHoldingsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0a0a0f" CornerRadius="4" Padding="8" Margin="0,0,0,4">
                                            <StackPanel>
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" Fill="{Binding Color}"/>
                                                        <TextBlock Text="{Binding Name}" Foreground="{Binding ForeColor}" FontSize="10" FontWeight="Bold" Margin="6,0"/>
                                                        <TextBlock Text="(我)" Visibility="{Binding IsMe}" Foreground="#9ca3af" FontSize="9"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding LongText}" Foreground="#22c55e" FontSize="10" Visibility="{Binding HasLong}"/>
                                                        <TextBlock Text="{Binding ShortText}" Foreground="#f97316" FontSize="10" Margin="8,0,0,0" Visibility="{Binding HasShort}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- My Holdings -->
                            <Border x:Name="MyHoldingPanel" Background="#0a0a0f" CornerRadius="6" Padding="10" Margin="0,8,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="我的持仓" Foreground="#6b7280" FontSize="10" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Foreground="#6b7280" FontSize="10">
                                            <Run Text="多头:"/><Run x:Name="MyLongQty" Text="0" Foreground="#22c55e"/>
                                        </TextBlock>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Foreground="#6b7280" FontSize="10">
                                            <Run Text="空头:"/><Run x:Name="MyShortQty" Text="0" Foreground="#f97316"/>
                                        </TextBlock>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Foreground="#6b7280" FontSize="10" Margin="0,4,0,0">
                                            <Run Text="多成本:"/><Run x:Name="MyLongCost" Text="$0" Foreground="#d1d5db"/>
                                        </TextBlock>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Foreground="#6b7280" FontSize="10" Margin="0,4,0,0">
                                            <Run Text="空成本:"/><Run x:Name="MyShortCost" Text="$0" Foreground="#d1d5db"/>
                                        </TextBlock>
                                    </Grid>
                                    <StackPanel x:Name="MyPnlPanel" Margin="0,6,0,0" Visibility="Collapsed">
                                        <TextBlock Foreground="#6b7280" FontSize="10">
                                            <Run Text="多盈亏:"/><Run x:Name="MyLongPnl" Text="$0"/>
                                        </TextBlock>
                                        <StackPanel x:Name="ShortDefensePanel" Margin="0,6,0,0" Visibility="Collapsed">
                                            <TextBlock Text="📌 做空保证金" Foreground="#f97316" FontSize="10" FontWeight="Bold"/>
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="初始保证金" Foreground="#6b7280" FontSize="10"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ShortInitialMargin" Text="$0" Foreground="#3b82f6" FontSize="10"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="维持保证金" Foreground="#6b7280" FontSize="10" Margin="0,2,0,0"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ShortMaintenance" Text="$0" Foreground="#fbbf24" FontSize="10" Margin="0,2,0,0"/>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="当前可用" Foreground="#6b7280" FontSize="10" Margin="0,2,0,0"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ShortAvailable" Text="$0" Foreground="#22c55e" FontSize="10" Margin="0,2,0,0"/>

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="健康度" Foreground="#6b7280" FontSize="10" Margin="0,2,0,0"/>
                                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ShortHealth" Text="100%" Foreground="#22c55e" FontSize="10" Margin="0,2,0,0"/>

                                                <TextBlock Grid.Row="4" Grid.Column="0" Text="浮动盈亏" Foreground="#6b7280" FontSize="10" Margin="0,2,0,0"/>
                                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ShortPnl" Text="$0" Foreground="#22c55e" FontSize="10" Margin="0,2,0,0"/>

                                                <TextBlock Grid.Row="5" Grid.Column="0" Text="全部平仓预估" Foreground="#6b7280" FontSize="10" Margin="0,4,0,0"/>
                                                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="ShortCoverEstimate" Text="-" Foreground="#a78bfa" FontSize="10" Margin="0,4,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Trade Actions -->
                            <StackPanel Margin="0,12,0,0">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="BuyBtn" Content="买入" Click="SetAction_Click" Tag="buy" Margin="0,0,2,0"
                                            Background="#22c55e" Foreground="White" BorderThickness="0" Padding="5,6" FontSize="11" FontWeight="Bold"/>
                                    <Button Grid.Column="1" x:Name="SellBtn" Content="卖出" Click="SetAction_Click" Tag="sell" Margin="2,0"
                                            Background="#374151" Foreground="White" BorderThickness="0" Padding="5,6" FontSize="11" FontWeight="Bold"/>
                                    <Button Grid.Column="2" x:Name="ShortBtn" Content="做空" Click="SetAction_Click" Tag="short" Margin="2,0"
                                            Background="#374151" Foreground="White" BorderThickness="0" Padding="5,6" FontSize="11" FontWeight="Bold"/>
                                    <Button Grid.Column="3" x:Name="CoverBtn" Content="平空" Click="SetAction_Click" Tag="cover" Margin="2,0,0,0"
                                            Background="#374151" Foreground="White" BorderThickness="0" Padding="5,6" FontSize="11" FontWeight="Bold"/>
                                </Grid>

                                <Grid x:Name="QtyGrid" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="Qty1Btn" Content="1" Tag="1" Click="SetQuantity_Click" Margin="0,0,2,0"
                                            Background="#374151" Foreground="#d1d5db" BorderThickness="0" Padding="5,5" FontSize="11"/>
                                    <Button Grid.Column="1" Content="10" Tag="10" Click="SetQuantity_Click" Margin="2,0"
                                            Background="#374151" Foreground="#d1d5db" BorderThickness="0" Padding="5,5" FontSize="11"/>
                                    <Button Grid.Column="2" Content="50" Tag="50" Click="SetQuantity_Click" Margin="2,0"
                                            Background="#374151" Foreground="#d1d5db" BorderThickness="0" Padding="5,5" FontSize="11"/>
                                    <Button Grid.Column="3" Content="100" Tag="100" Click="SetQuantity_Click" Margin="2,0,0,0"
                                            Background="#374151" Foreground="#d1d5db" BorderThickness="0" Padding="5,5" FontSize="11"/>
                                </Grid>

                                <!-- Leverage Slider -->
                                <StackPanel x:Name="LeveragePanel" Visibility="Collapsed" Margin="0,0,0,8">
                                    <Grid>
                                        <TextBlock Text="杠杆" Foreground="#6b7280" FontSize="10"/>
                                        <TextBlock x:Name="LeverageText" Text="1x" Foreground="#22d3ee" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="LeverageSlider" Minimum="1" Maximum="3" Value="1" 
                                            ValueChanged="LeverageSlider_ValueChanged" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Trade Info -->
                                <Border Background="#0a0a0f" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                    <TextBlock x:Name="TradeInfo" Text="" Foreground="#d1d5db" FontSize="10" TextWrapping="Wrap"/>
                                </Border>

                                <Button x:Name="ExecuteBtn" Content="确认买入" Click="ExecuteTrade_Click"
                                        Background="#f43f5e" Foreground="White" BorderThickness="0" Padding="15,10" FontSize="13" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Empty State -->
                    <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="点击左侧股票查看详情" Foreground="#6b7280" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
